# Beam
my_constants.gamma = 300/0.511
my_constants.Lbeam = floor(18e-6/lr)*lr
my_constants.w0 = 22.6e-6
my_constants.emit = 0.1e-6
my_constants.part_per_slice = 8192

# Undulator
my_constants.lu = 0.05
my_constants.K = 0.5
my_constants.nperiod = 110
my_constants.ku = 2*pi/lu
my_constants.B0 = m_e*clight*ku*K/q_e
my_constants.lr = lu/2/gamma**2*(1+K**2/2)
my_constants.kr = 2*pi/lr
my_constants.krcos = 0.
my_constants.chi = K**2 / 4 / (1+K**2/2)

# Seed
my_constants.Pseed = 5e6
my_constants.Wseed = 100e-6
my_constants.Eseed = sqrt( 4*Pseed / (pi * epsilon0 * clight * Wseed * Wseed) )
my_constants.Useed = q_e * Eseed / (m_e * clight * clight * kr)
my_constants.Fseed = Useed

# Numerics
my_constants.nsteps_per_period = 1
my_constants.dz_per_wavelength = 1
my_constants.phase = pi/nsteps_per_period
my_constants.zmin = -floor((Lbeam+nperiod*lr)/dz)*dz
my_constants.zmax =  10*dz
my_constants.dz = lr / dz_per_wavelength
my_constants.nx = 127
my_constants.nz = "((zmax-zmin)/lr*dz_per_wavelength)" # PUFFIN
my_constants.output_period = max(1,10*nsteps_per_period)
my_constants.insitu_period = max(1,nsteps_per_period)

hipace.dt = lu/clight/nsteps_per_period
max_step = nsteps_per_period*nperiod
comms_buffer.on_gpu = 1
hipace.do_device_synchronize = 0
comms_buffer.max_size_GiB = 40

hipace.verbose = 4
hipace.output_input = 0

comms_buffer.async_memcpy = 1
boundary.field = Dirichlet
boundary.particle = Reflecting
# geometry.prob_lo     = -300e-6 -300e-6 zmin
# geometry.prob_hi     =  300e-6  300e-6 zmax
geometry.prob_lo     = -500e-6 -500e-6 zmin
geometry.prob_hi     =  500e-6  500e-6 zmax
amr.n_cell = nx nx nz

plasmas.names = no_plasma

beams.names = beam
beams.insitu_period = insitu_period

beam.injection_type = from_file
beam.input_file = BEAMS.OPENPMD/beam.8192_00000.h5
# beam.injection_type = fixed_weight_pdf
# beam.pdf = if (-Lbeam<z<=0,1,0)
# beam.pdf_ref_ratio = 10
# beam.position_mean = 0 0
# beam.position_std = w0 w0
# beam.total_charge = 300e-12
# beam.u_mean = 0 0 gamma
# beam.u_std = emit/w0 emit/w0 gamma*1e-4
# beam.num_particles = part_per_slice*Lbeam/lr
beam.n_subcycles = 10
beam.use_mag = 1
beam.mag_B0 = B0
beam.mag_period = lu
beam.mag_phase = phase
beam.mag_fc = jn(0,chi) - jn(1,chi)

beamsub.injection_type = fixed_weight_pdf
beamsub.pdf = if (-Lbeam<z<=0,1,0)
beamsub.pdf_ref_ratio = 10
beamsub.position_mean = 0 0
beamsub.position_std = w0 w0
beamsub.total_charge = 300e-22
beamsub.u_mean = 0 0 gamma
beamsub.u_std = emit/w0 emit/w0 gamma*1e-4
beamsub.num_particles = 1e6
beamsub.n_subcycles = 1
beamsub.use_mag = 1
beamsub.mag_B0 = B0
beamsub.mag_period = lu
beamsub.mag_phase = phase
beamsub.mag_fc = jn(0,chi) - jn(1,chi)

helmholtz.use_helmholtz = 1
helmholtz.mode = "envelope"
helmholtz.lambda0 = lr
helmholtz.use_phase = 1
helmholtz.use_mg = 0
helmholtz.interp_z = 1
helmholtz.zfilter_source = 1

helmholtz.insitu_period = insitu_period
helmholtz.field_real(x,y,z) = Fseed * exp(-(x**2+y**2)/Wseed**2) * cos(krcos*z)

diagnostic.names = helmholtz_diag
diagnostic.diag_type = xz
diagnostic.beam_data = beam
diagnostic.beam_output_period = output_period
diagnostic.output_period = output_period
diagnostic.base_geometry = helmholtz
hipace.file_prefix = diags/hdf5
beams.insitu_file_prefix = diags/insitu
helmholtz.insitu_file_prefix = diags/insitu
